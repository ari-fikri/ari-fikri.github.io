{
  "name": "ari-fikri.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync-images && tinacms dev -c \"next dev --webpack\"",
    "tina:dev": "tinacms dev -c \"next dev --webpack\"",
    "sync-images": "mkdir -p public/cms-posts && cp -r cms-posts/public/* public/cms-posts/ || true",
    "build": "npm run sync-images && node --max-old-space-size=4096 ./node_modules/.bin/tinacms build && next build --webpack",
    "build:local": "node --env-file=.env.local --max-old-space-size=4096 ./node_modules/.bin/tinacms build && next build --webpack",
    "tina:build": "tinacms build",
    "start": "next start",
    "lint": "oxlint"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@svgr/webpack": "^8.1.0",
    "gray-matter": "^4.0.3",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "tinacms": "^3.11.0"
  },
  "devDependencies": {
    "@tinacms/cli": "^2.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.71.0",
    "sitemap": "^9.0.1"
  }
}
